# Runtime (required in production; local development defaults to development)
SLATE_ENV=development

# Backend database (required when SLATE_ENV=production)
# Development-only SQLite example; use a managed PostgreSQL URL in production.
SLATE_DATABASE_URL=sqlite:///./data/slate.db

# Backend browser access (required in production; comma-separated exact origins)
SLATE_ALLOWED_ORIGINS=http://localhost:3000

# Data providers (all optional; no provider key is exposed to the browser)
# Keep true for deterministic demos, tests, and CI. Set false only when live adapters are configured.
SLATE_OFFLINE_MODE=true
SLATE_ALPHA_VANTAGE_KEY=
SLATE_FRED_API_KEY=
# Required only when implementing SEC EDGAR live calls. Use an organization contact, never a personal address.
SLATE_SEC_USER_AGENT=SlateMarketResearch/0.1 contact@example.com

# Frontend (browser-exposed; this value must never contain credentials)
NEXT_PUBLIC_API_URL=http://localhost:8000
