# Runtime (APP_ENV is required in production; local development defaults to development)
APP_ENV=development

# Backend database. SQLite is suitable for local development and disposable demos.
# Use a managed PostgreSQL URL only when persistent production data is required.
DATABASE_URL=sqlite:///./data/slate.db

# Backend browser access for split-origin local development. The single-service Render
# deployment does not need CORS because its frontend and API use the same origin.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,https://gsingh2005.github.io

# Data providers (all optional; no provider key is exposed to the browser)
# Keep true for deterministic demos, tests, and CI. Set false only when live adapters are configured.
SLATE_OFFLINE_MODE=true
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# Required only when implementing SEC EDGAR live calls. Use an organization contact, never a personal address.
SEC_USER_AGENT=SlateMarketResearch/0.1 contact@example.com
LOG_LEVEL=INFO
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
# Demo watchlists seed locally by default and are disabled by default in production.
SLATE_SEED_DEMO_DATA=true

# Frontend (browser-exposed; this value must never contain credentials)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set by the production container to the directory produced by Next static export.
SLATE_FRONTEND_DIST_DIR=
